{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fake-faces",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "pi/main.py",
        "--backend",
        "fake",
        "--port",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "webcam",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "pi/main.py",
        "--backend",
        "mediapipe",
        "--source",
        "opencv",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "fake-faces-8090",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "pi/main.py",
        "--backend",
        "fake",
        "--port",
        "8090"
      ],
      "port": 8090
    },
    {
      "name": "demo",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8770",
        "--bind",
        "127.0.0.1",
        "--directory",
        "Demo"
      ],
      "port": 8770
    },
    {
      "name": "haptics-dashboard",
      "runtimeExecutable": "firmware/directional_haptics/.venv/bin/python",
      "runtimeArgs": [
        "firmware/directional_haptics/record.py",
        "--serial",
        "/dev/cu.usbserial-110",
        "--port",
        "8766"
      ],
      "port": 8766
    }
  ]
}
