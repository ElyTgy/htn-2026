# Speechmatics Realtime Enhanced live captions with speaker diarization.
# Create a key at https://portal.speechmatics.com/. The server exchanges it for a 60-second
# temporary realtime credential, so the API key never enters the browser.
SPEECHMATICS_API_KEY=

# Jetson-only. Prefer stable /dev/serial/by-id/... paths after running:
#   .venv/bin/python jetson/hardware_bridge.py --list-ports
ARDUINO_PORT=auto
TITAN_PORT=auto
SOUND_CALIBRATION=jetson/sound_calibration.json

# csi or usb. CSI_SENSOR_ID may be 0 or 1; auto tries both.
JETSON_CAMERA=csi
CSI_SENSOR_ID=auto
USB_CAMERA_INDEX=0
