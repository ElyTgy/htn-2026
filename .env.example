# Copy to .env and fill in. Get a key at https://console.deepgram.com (free credit on signup).
# Give the key "Member" permission so the Pi can mint 30-second tokens for the page;
# otherwise the key itself is sent to the page, which is OK on a private hotspot only.
DEEPGRAM_API_KEY=

# Optional: Speechmatics Enhanced live captions + speaker diarization.
# Create a key at https://portal.speechmatics.com/ and select Speechmatics in Settings.
SPEECHMATICS_API_KEY=

# Jetson-only. Prefer stable /dev/serial/by-id/... paths after running:
#   .venv/bin/python jetson/hardware_bridge.py --list-ports
ARDUINO_PORT=auto
TITAN_PORT=auto
SOUND_CALIBRATION=jetson/sound_calibration.json

# csi or usb. CSI_SENSOR_ID may be 0 or 1; auto tries both.
JETSON_CAMERA=csi
CSI_SENSOR_ID=auto
USB_CAMERA_INDEX=0
